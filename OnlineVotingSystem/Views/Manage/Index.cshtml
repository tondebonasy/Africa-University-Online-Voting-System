@model OnlineVotingSystem.Models.IndexViewModel
@{ ViewBag.Title = "My account"; }
<section class="page-intro"><p class="eyebrow">STUDENT ACCOUNT</p><h1>Welcome, @User.Identity.Name.</h1><p>Manage your account and keep your sign-in details up to date.</p></section>
@if (!String.IsNullOrWhiteSpace(Convert.ToString(ViewBag.StatusMessage))) { <div class="alert alert-success" role="status">@ViewBag.StatusMessage</div> }
<div class="row g-4"><div class="col-lg-6"><section class="election-panel card h-100 mb-0"><h2 class="fs-5">Sign-in security</h2><p class="field-hint mb-4">Choose a strong password and avoid sharing your account.</p>@if (Model.HasPassword) { @Html.ActionLink("Change password", "ChangePassword", null, new { @class = "btn btn-outline-primary" }) } else { @Html.ActionLink("Set a password", "SetPassword", null, new { @class = "btn btn-outline-primary" }) }</section></div><div class="col-lg-6"><section class="election-panel card h-100 mb-0"><h2 class="fs-5">Your election account</h2><dl class="dl-horizontal mt-4 mb-0"><dt>Student ID</dt><dd>@User.Identity.Name</dd><dt>Phone number</dt><dd>@(String.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)</dd></dl></section></div></div>
@if (Model.Logins != null && Model.Logins.Count > 0) { <section class="election-panel card mt-4"><h2 class="fs-5">Connected sign-in providers</h2><p class="field-hint">You have @Model.Logins.Count connected sign-in provider(s).</p>@Html.ActionLink("Manage connected accounts", "ManageLogins", null, new { @class = "btn btn-outline-primary" })</section> }
