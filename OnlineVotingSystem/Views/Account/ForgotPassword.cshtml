@model OnlineVotingSystem.Models.ForgotPasswordViewModel
@{ ViewBag.Title = "Account recovery"; Layout = "~/Views/Shared/AuthLayout.cshtml"; }
<div class="auth-heading"><p class="eyebrow">ACCOUNT SUPPORT</p><h2>Let us help you get back in.</h2><p>Email-based password recovery has not been configured for this installation. Contact your university election administrator through your established university support channel to recover your account.</p></div>
<div class="alert alert-info">Never share your password or verification codes with anyone.</div>
<a class="btn btn-primary w-100" href="@Url.Action("Contact", "Home")">Get account help <span aria-hidden="true">&rarr;</span></a>
<p class="auth-switch">Remember your password? @Html.ActionLink("Back to sign in", "Login")</p>


