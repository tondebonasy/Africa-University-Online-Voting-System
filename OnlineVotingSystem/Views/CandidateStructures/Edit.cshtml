@model OnlineVotingSystem.Models.CandidateStructure

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="management-panel card">

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            <h4>CandidateStructure</h4>
            <hr />
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="form-group">
                @Html.LabelFor(model => model.candidateId, "candidateId", htmlAttributes: new { @class = "form-label col-md-2" })
                <div class="col-md-10">
                    @Html.DropDownList("candidateId", null, htmlAttributes: new { @class = "form-select" })
                    @Html.ValidationMessageFor(model => model.candidateId, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.structureId, "structureId", htmlAttributes: new { @class = "form-label col-md-2" })
                <div class="col-md-10">
                    @Html.DropDownList("structureId", null, htmlAttributes: new { @class = "form-select" })
                    @Html.ValidationMessageFor(model => model.structureId, "", new { @class = "text-danger" })
                </div>
            </div>

            @Html.HiddenFor(model => model.id)

            <div class="form-group">
                <div class="offset-md-2 col-md-10">
                    <input type="submit" value="Save" class="btn btn-outline-secondary" />
                </div>
            </div>
        </div>
    }

    <div>
        @Html.ActionLink("Back to List", "Index")
    </div>
    </div>

    @section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
    }




