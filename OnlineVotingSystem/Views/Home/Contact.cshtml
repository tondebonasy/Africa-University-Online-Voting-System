@{ ViewBag.Title = "Election help"; }
<section class="page-intro"><p class="eyebrow">WE ARE HERE TO HELP</p><h1>Your questions, answered.</h1><p>A quick guide to participating in Africa University student elections.</p></section>
<div class="accordion help-accordion" id="electionHelp">
    <div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#helpVote" aria-expanded="true" aria-controls="helpVote">How do I cast my vote?</button></h2><div id="helpVote" class="accordion-collapse collapse show" data-bs-parent="#electionHelp"><div class="accordion-body">Sign in with your registered student account, open Candidates, and select a representative for each position during an open election. Review your choice before confirming. Submitted votes cannot be changed.</div></div></div>
    <div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#helpClosed" aria-expanded="false" aria-controls="helpClosed">Why is voting closed?</button></h2><div id="helpClosed" class="accordion-collapse collapse" data-bs-parent="#electionHelp"><div class="accordion-body">Voting is available only between the scheduled start and end times. Check the election overview for upcoming dates.</div></div></div>
    <div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#helpAccount" aria-expanded="false" aria-controls="helpAccount">What if I cannot access my account?</button></h2><div id="helpAccount" class="accordion-collapse collapse" data-bs-parent="#electionHelp"><div class="accordion-body">Contact your university election administrator or Student Affairs through your established university support channel. Include the page and error message, but never share your password. Email recovery is not configured for this installation.</div></div></div>
</div>
<a class="btn btn-outline-primary mt-4" href="@Url.Action("Index")">Back to election overview</a>
